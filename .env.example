# --- LLM providers (agents run with deterministic fallbacks if both are empty) ---
# DeepSeek is the PRIMARY provider; Anthropic is used only as fallback when
# DeepSeek is unconfigured or a DeepSeek call fails.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# --- Platform (cloud control plane) ---
PLATFORM_DATABASE_URL=postgres://dental:dental@localhost:5442/dental
TEMPORAL_ADDRESS=localhost:7233
API_URL=http://localhost:4100
API_PORT=4100
AGENTS_URL=http://localhost:8100
JWT_SECRET=dev-jwt-secret-change-me

# --- Simulated on-prem OpenDental (one MySQL per location) ---
OPENDENTAL_A_URL=mysql://od:odpass@localhost:3307/opendental
OPENDENTAL_B_URL=mysql://od:odpass@localhost:3308/opendental

# --- Edge Synchronizer site credentials (per-site API keys) ---
EDGE_SITE_A_API_KEY=edge-key-site-a-dev
EDGE_SITE_B_API_KEY=edge-key-site-b-dev

# --- PMS integration mode (A1) ---
# api   = OpenDental REST API (OD_API_URL; use tools/mock-od-api in dev)
# mysql = DateTStamp polling of the simulated/real OpenDental MySQL (default)
# mock  = embedded practice simulator, no PMS at all (pure demo/dev/CI)
# Per-site overrides: PMS_MODE_A / PMS_MODE_B.
PMS_MODE=mysql
# Set to `mock` to hot-swap to the embedded simulator when the configured
# adapter fails health checks — demos never die, dashboard shows the badge.
PMS_FALLBACK=
# OpenDental REST API credentials (PMS_MODE=api); the mock fixture accepts any.
OD_API_URL=http://localhost:8388
OD_API_DEV_KEY=dev-key
OD_API_CUST_KEY=cust-key
# Port for the OD API-Events webhook hint listener on the edge (0 = disabled).
EDGE_WEBHOOK_PORT=0

# --- Practice simulator (A2) ---
# Tick speed multiplier for live activity (mock adapter + `pnpm simulate live`).
SIM_SPEED=1
MOCK_SEED=

# --- Web app origin (SSO redirects + CORS) ---
WEB_URL=http://localhost:3000

# --- SSO via OIDC (leave OIDC_ISSUER empty to disable) ---
# Works with any OIDC IdP: Google Workspace, Okta, Azure AD, or the local dev
# IdP (`node tools/dev-idp/server.mjs`, issuer http://localhost:9400,
# client id `dental-web`, secret `dev-idp-secret`).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO
# Auto-create users on first SSO login (default: only pre-existing emails may sign in)
OIDC_AUTO_PROVISION=false
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_DEFAULT_ROLE=staff

# --- Twilio SMS (leave empty to keep the simulated SMS Console) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS base Twilio calls back on (e.g. an ngrok tunnel to :4100)
TWILIO_WEBHOOK_BASE_URL=
